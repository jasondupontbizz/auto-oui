{
  "manifest_version": 3,
  "name": "Auto-Oui",
  "description": "Répond « Oui » automatiquement aux demandes d'approbation des agents IA, dans les onglets que tu actives.",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto-Oui",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
